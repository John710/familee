# Everything that has no business being inside the image. The smaller the
# context, the faster the build and the less often it invalidates layer cache.
.git
.gitignore
.dockerignore
Dockerfile
docker-compose*.yml
node_modules
.next
out
build
.env
.env.*
!.env.example
*.md
!README.md
.idea
.vscode
media
backups
# Personal material: docs/ holds the family's own GEDCOM and notes. A bare `*.ged` matches only
# the root, so the patterns reach into every folder.
docs
**/*.ged
**/*.GED
.mcp.json
.claude
tools
*.tsbuildinfo

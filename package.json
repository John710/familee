        "drizzle-zod": "0.8.3",
        "ioredis": "6.0.0",
        "lucide-react": "1.31.0",
        "next": "16.3.0",
        "next-intl": "4.13.6",
        "next-themes": "0.4.6",
        "postgres": "3.4.9",
        "radix-ui": "1.6.7",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "sharp": "0.35.3",

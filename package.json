{
    "name": "familee",
    "version": "0.6.1",
    "license": "MIT",
    "private": true,
    "description": "Family tree: persons, unions, events, photographs",
    "type": "module",
    "engines": {
        "node": ">=26"
    },
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "typecheck": "tsc --noEmit",
        "lint": "biome check .",
        "format": "biome check --write .",
        "test:i18n": "node scripts/check-messages.mjs",
        "test:unit": "node --import ./tests/loader.mjs --test tests/",
        "test": "npm run typecheck && npm run lint && npm run test:unit && npm run test:i18n",
        "db:tools": "bash db/tools.sh",
        "db:check": "drizzle-kit check",
        "db:pull": "drizzle-kit pull",
        "db:studio": "drizzle-kit studio"
    },
    "dependencies": {
        "@better-auth/drizzle-adapter": "1.7.14",
        "@xyflow/react": "12.12.0",
        "better-auth": "1.7.14",
        "class-variance-authority": "0.7.1",
        "clsx": "2.1.1",
        "drizzle-orm": "0.45.4",
        "drizzle-zod": "0.8.3",
        "ioredis": "6.0.0",
        "leaflet": "1.9.4",
        "lucide-react": "1.63.0",
        "next": "16.4.3",
        "next-intl": "4.14.9",
        "next-themes": "0.4.6",
        "postgres": "3.4.9",
        "radix-ui": "1.8.1",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "sharp": "0.35.5",
        "tailwind-merge": "3.7.0",
        "zod": "4.6.7"
    },
    "overrides": {
        "esbuild": "0.28.2",
        "@esbuild-kit/esm-loader": "npm:tsx@4.23.15"
    },
    "devDependencies": {
        "@biomejs/biome": "2.6.3",
        "@tailwindcss/postcss": "4.3.3",
        "@types/leaflet": "1.9.22",
        "@types/node": "26.6.6",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "daisyui": "5.7.50",
        "drizzle-kit": "0.31.11",
        "tailwindcss": "4.3.3",
        "tw-animate-css": "1.4.0",
        "typescript": "7.0.2"
    },
    "allowScripts": {
        "@parcel/watcher@2.6.0": true,
        "@swc/core@1.16.18": true,
        "esbuild@0.28.2": true
    }
}

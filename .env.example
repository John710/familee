# Familee - a sample configuration. Copy it to .env and fill it in:
#   cp .env.example .env
# The .env file never reaches git (see .gitignore).

# ─── Database ───────────────────────────────────────────────────────
# Postgres already runs on the server - only the connection string here.
# The host name (postgres) has to be the container name or one of its
# aliases in the shared Docker network, see DATA_NETWORK below.
# Every object of the application lives in the familee schema and touches
# nothing in the other schemas of that database.
DATABASE_URL=postgresql://familee:password@postgres:5432/familee

# The connection pool size of a single application container.
DATABASE_POOL_MAX=10

# ─── Redis ──────────────────────────────────────────────────────────
# Already running as well. Pick a free database number so as not to mix
# with other applications that share the same Redis.
REDIS_URL=redis://redis:6379/3

# ─── Sign-in ────────────────────────────────────────────────────────
# The secret used to sign sessions. Generate it with:
#   openssl rand -base64 48
BETTER_AUTH_SECRET=

# The external address of the application - the same as FAMILEE_HOST below.
BETTER_AUTH_URL=https://familee.example.com

# ─── Application ────────────────────────────────────────────────────
# The time zone used to display the time of an edit.
APP_TIME_ZONE=Asia/Vladivostok

# Where to keep the photographs inside the container. The directory is
# mounted as the familee_media volume (see docker-compose.yml).
MEDIA_ROOT=/data/media

# The size limit of a single uploaded file, in MB.
MEDIA_MAX_UPLOAD_MB=25

# ─── Traefik ────────────────────────────────────────────────────────
# The domain the archive is served on.
FAMILEE_HOST=familee.example.com

# The name of the network traefik runs in, and its TLS entrypoint.
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# ─── Docker networks ────────────────────────────────────────────────
# The network postgres (and redis) already runs in. It can be looked up
# like this (substitute the name of your own container):
#   docker inspect -f '{{range $n,$_ := .NetworkSettings.Networks}}{{$n}} {{end}}' postgres
DATA_NETWORK=db-network

# Familee - a sample configuration. Copy it to .env and fill it in:
#   cp .env.example .env
# The .env file never reaches git (see .gitignore). Keep its mode at 600.

# ─── How the archive is reached ─────────────────────────────────────
# Mode 1, the default: by IP address and port of the server, plain HTTP.
#   BETTER_AUTH_URL=http://192.168.0.10:3000
#
# Mode 2: behind Traefik over HTTPS. Set the domain and switch the compose files:
#   FAMILEE_HOST=familee.example.com
#   BETTER_AUTH_URL=https://familee.example.com
#   COMPOSE_FILE=docker-compose.build.yml:docker-compose.traefik.yml
#
# BETTER_AUTH_URL must be the address the browser uses, port included, or sign-in
# is refused as coming from another origin.
BETTER_AUTH_URL=http://localhost:3000

# The port the application is published on in mode 1 (ignored in mode 2).
FAMILEE_PORT=3000

# The release of the published image to run (docker-compose.image.yml only). The tag is an exact
# release, never `latest`, so an upgrade is a visible change of this number.
# FAMILEE_VERSION=0.7.0

# The compose files to use. Mode 1 needs only the first one.
# COMPOSE_FILE=docker-compose.build.yml:docker-compose.traefik.yml

# ─── Database ───────────────────────────────────────────────────────
# Postgres must already be running. The host name is its container name, which
# has to resolve inside DATA_NETWORK (see below).
# Every object of the application lives in the familee schema and touches
# nothing in the other schemas of that database.
DATABASE_URL=postgres://familee:password@postgres:5432/familee

# The connection pool size of a single application container.
DATABASE_POOL_MAX=10

# ─── Redis ──────────────────────────────────────────────────────────
# Must already be running. Pick a database number that no other application
# on the same Redis uses.
REDIS_URL=redis://redis:6379/3

# ─── Sign-in ────────────────────────────────────────────────────────
# The secret used to sign sessions. Generate it with:
#   openssl rand -base64 48
BETTER_AUTH_SECRET=

# ─── Application ────────────────────────────────────────────────────
# The time zone used to display the time of an edit (an IANA name).
APP_TIME_ZONE=Asia/Vladivostok

# Where to keep the photographs inside the container. The directory is
# mounted as the familee_media volume (see docker-compose.build.yml).
MEDIA_ROOT=/data/media

# The size limit of a single uploaded file, in MB.
MEDIA_MAX_UPLOAD_MB=25

# ─── Map ────────────────────────────────────────────────────────────
# The tile server the map asks for its streets, and the line of credit shown
# in the corner. The default is OpenStreetMap, whose policy asks that a busy
# site name its own server rather than use theirs. `{z}`, `{x}` and `{y}` are
# filled in by the map. On a network without a way out the map still opens -
# the markers and the roads are drawn on an empty background - so the page
# never breaks, it only loses its streets.
# MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# MAP_ATTRIBUTION=© OpenStreetMap contributors

# The container applies the migrations from db/migrations on start. Set this to 1
# to skip that (a second instance that must not touch the schema, say).
SKIP_MIGRATIONS=0

# ─── Traefik (mode 2 only) ──────────────────────────────────────────
# The domain the archive is served on, the entrypoint and the certificate resolver
# configured in your Traefik, and the network Traefik runs in.
FAMILEE_HOST=
TRAEFIK_NETWORK=traefik

# The proxies in front of the archive, as addresses or CIDR ranges, comma-separated. In the
# Traefik mode put the subnet of TRAEFIK_NETWORK here, so that the client's address is read from
# X-Forwarded-For correctly (the sign-in limit per address depends on it). Leave it empty for the
# address-and-port mode.
TRUSTED_PROXIES=
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# ─── Docker networks of the shared services ─────────────────────────
# The network postgres and redis run in. Look it up with:
#   docker inspect -f '{{range $n,$_ := .NetworkSettings.Networks}}{{$n}} {{end}}' postgres
DATA_NETWORK=postgres
